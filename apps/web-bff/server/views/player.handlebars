<section class="page-heading">
  <div><p class="eyebrow">{{player.team}}</p><h1>{{player.name}} <fanta-badge tone="{{player.role}}">{{player.role}}</fanta-badge></h1></div>
</section>

{{#unless indicators}}
<p class="flash flash--warning">Dati non ancora disponibili per questo giocatore: è in attesa di arricchimento FPEDIA (o non è mai stato trovato su FPEDIA). Punteggi e prezzo atteso non possono essere calcolati finché non ci sono questi dati.</p>
{{/unless}}

{{#if indicators}}
{{#if indicators.warnings.length}}
{{#each indicators.warnings}}<p class="flash flash--warning">{{warningLabel this}}</p>{{/each}}
{{/if}}

<section class="stats-grid">
  <div>
    <fanta-stat-card label="Technical score" value="{{indicators.technical.technicalProjectionScore}}" trend="positive"></fanta-stat-card>
    <span class="stat-caption">0–100, più alto = proiezione tecnica migliore</span>
  </div>
  <div>
    <fanta-stat-card label="Risk score" value="{{indicators.technical.riskScore}}" trend="warning"></fanta-stat-card>
    <span class="stat-caption">0–100, più alto = più rischioso (infortuni/incertezza)</span>
  </div>
  <div>
    <fanta-stat-card label="Scarcity" value="{{indicators.technical.scarcityIndex}}" trend="neutral"></fanta-stat-card>
    <span class="stat-caption">{{#if (eq indicators.technical.scarcityIndex null)}}non disponibile: dati insufficienti per questo giocatore{{else}}0–100, più alto = più sopra il livello di replacement del ruolo (domanda reale di rosa){{/if}}</span>
  </div>
  <div>
    <fanta-stat-card label="Expected price" value="{{indicators.market.expectedPrice}}" suffix=" cr" trend="neutral"></fanta-stat-card>
    <span class="stat-caption">{{confidenceLabel display.confidence}} sulla valutazione complessiva</span>
  </div>
</section>

{{#if display.reasons.length}}
<section class="panel">
  <div class="panel__header"><h2>Perché questa valutazione</h2></div>
  <ul class="reasons-list">
    {{#each display.reasons}}<li>{{this}}</li>{{/each}}
  </ul>
</section>
{{/if}}

<section class="panel">
  <div class="panel__header"><h2>Punteggio tecnico</h2></div>
  <p class="panel__hint">Come si arriva al Technical score qui sopra: segnali editoriali, proiezione, storico, disponibilità.</p>
  <div class="kv-grid">
    {{#each display.technical}}
    <div class="kv-row">
      <span class="kv-row__label">{{this.label}}</span>
      <span class="kv-row__value">{{#if (eq this.value null)}}—{{else}}{{this.value}}{{/if}}{{#if this.detail}} <span class="kv-row__detail">({{this.detail}})</span>{{/if}}</span>
    </div>
    {{/each}}
  </div>
</section>

<section class="panel">
  <div class="panel__header"><h2>Rischio e affidabilità</h2></div>
  <p class="panel__hint">Quanto è rischioso puntarci e quanto ci si può fidare di questa valutazione.</p>
  <div class="kv-grid">
    {{#each display.risk}}
    <div class="kv-row">
      <span class="kv-row__label">{{this.label}}</span>
      <span class="kv-row__value">{{#if (eq this.value null)}}—{{else}}{{this.value}}{{/if}}</span>
    </div>
    {{/each}}
  </div>
</section>

<section class="panel">
  <div class="panel__header"><h2>Valore relativo nel ruolo</h2></div>
  <p class="panel__hint">Quanto vale rispetto agli altri giocatori dello stesso ruolo, non in assoluto.</p>
  <div class="kv-grid">
    {{#each display.relativeValue}}
    <div class="kv-row">
      <span class="kv-row__label">{{this.label}}</span>
      <span class="kv-row__value">{{#if (eq this.value null)}}—{{else}}{{this.value}}{{/if}}</span>
    </div>
    {{/each}}
  </div>
</section>

<section class="panel">
  <div class="panel__header"><h2>Mercato</h2></div>
  <p class="panel__hint">Calibrazione: {{calibrationLabel indicators.market.calibration}} &middot; {{confidenceLabel indicators.market.confidence}}</p>
  <div class="kv-grid">
    <div class="kv-row"><span class="kv-row__label">Prezzo atteso</span><span class="kv-row__value">{{#if (eq indicators.market.expectedPrice null)}}—{{else}}{{indicators.market.expectedPrice}} cr{{/if}}</span></div>
    {{#if indicators.market.range}}
    <div class="kv-row"><span class="kv-row__label">Intervallo plausibile</span><span class="kv-row__value">{{indicators.market.range.low}}&ndash;{{indicators.market.range.high}} cr</span></div>
    {{/if}}
  </div>
</section>

{{#if display.leagueSpecific}}
<section class="panel">
  <div class="panel__header"><h2>Dati specifici di lega</h2></div>
  <div class="kv-grid">
    {{#each display.leagueSpecific}}
    <div class="kv-row">
      <span class="kv-row__label">{{this.label}}</span>
      <span class="kv-row__value">{{#if (eq this.value null)}}—{{else}}{{this.value}}{{/if}}</span>
    </div>
    {{/each}}
  </div>
</section>
{{/if}}

<p class="model-meta">Modello {{display.meta.modelVersion}} &middot; stagione {{display.meta.modelSeason}} &middot; calcolato il {{display.meta.computedAt}}</p>
{{/if}}
